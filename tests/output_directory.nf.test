nextflow_pipeline {
    name "Direct invocation requires an output directory"
    script "../main.nf"
    config "nextflow.config"
    test("Missing outdir fails before launching any processes") {
        when {
            params {
                outdir = null
            }
        }
        then {
            assert workflow.failed
            assert workflow.stdout.toString().contains("Choose --outdir for direct Nextflow runs")
        }
    }
}
